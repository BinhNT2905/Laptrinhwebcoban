<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="BTL.Site" %>

<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="UTF-8" />
    <title>LuxeBag - <asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>
    
    <link rel="stylesheet" href="Style.css" /> 
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server"> 
        <div class="top-bar">
            <span>TMB</span>
        </div>

        <header class="header">
            <div class="logo-area">
                <div class="logo" onclick="window.location.href='TrangChu.aspx';">
                    <img src="OIP.png" alt="Logo">
                </div>
                <div class="sub-text">
                    Kho giao hàng :
                    <select id="warehouse">
                        <option value="hn">Hà Nội</option>
                        <option value="hcm">TP HCM</option>
                    </select>
                </div>
            </div>

            <nav class="nav">
                <a href="TrangChu.aspx">Trang Chủ</a>
                <a href="SanPhamMoi.aspx">Sản Phẩm Mới</a>
                <a href="TinTuc.aspx">Tin Tức</a>
                <a href="#">Giới thiệu</a>
            </nav>

            <div class="actions">

                <asp:PlaceHolder ID="phChucNangAdmin" runat="server" Visible="false">
                    <a href="Dashboard.aspx" class="icon" title="Dashboard Admin"><i class="fas fa-cog"></i></a>
                </asp:PlaceHolder>

                <asp:PlaceHolder ID="phChuaDangNhap" runat="server">
                    <a href="DangNhap.aspx" class="icon" title="Đăng nhập/Đăng ký"><i class="far fa-user"></i></a>
                </asp:PlaceHolder>
                
                <asp:PlaceHolder ID="phDaDangNhap" runat="server" Visible="false">
                    <span class="icon" title="Tài khoản"><i class="far fa-user"></i></span>
                    <asp:Label ID="lblUsername" runat="server" Font-Bold="true" Style="font-size: 14px; color: #d62b70;"></asp:Label>
                    <asp:LinkButton ID="lbtDangXuat" runat="server" Text="Thoát" OnClick="lbtDangXuat_Click" CssClass="action-item" Style="font-size: 14px; text-decoration: none; color: #333;"></asp:LinkButton>
                </asp:PlaceHolder>

                <%-- ICON GIỎ HÀNG CHỈ CÒN ICON, KHÔNG CÒN SỐ LƯỢNG --%>
                <a href="GioHang.aspx" class="icon"><i class="fas fa-shopping-bag"></i></a> 
            </div>
        </header>

        <div class="main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <footer class="footer">
            <div class="footer-top">
                <div class="footer-column">
                    <h4>Hỗ trợ khách hàng</h4>
                    <ul>
                        <li><a href="#">FAQ</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Chính sách bảo hành</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h4>Về LuxeBag</h4>
                    <ul>
                        <li><a href="#">Giới thiệu</a></li>
                        <li><a href="#">Danh sách cửa hàng</a></li>
                        <li><a href="#">Tuyển dụng</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h4>Kết nối với LuxeBag</h4>
                    <p>Hotline: 1900 6909</p>
                    <div class="social-icons">
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-tiktok"></i></a>
                        <a href="#"><i class="fab fa-zalo"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; <%# DateTime.Now.Year %> LuxeBag Fashion. All Rights Reserved.</p>
                <div class="footer-cert">
                    </div>
            </div>
        </footer>
    </form>
    <script>
            window.addEventListener("scroll", function () {
                const header = document.querySelector(".header");
                if (window.scrollY > 40) header.classList.add("sticky");
                else header.classList.remove("sticky");
            });
    </script>

</body>
</html>